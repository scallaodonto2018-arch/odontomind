# OdontoMind — variáveis de ambiente
# Copie para .env e preencha

# PostgreSQL (Railway ou local)
DATABASE_URL=postgresql://usuario:senha@host:5432/odontomind

# Segredo para validar webhooks (opcional mas recomendado)
WEBHOOK_SECRET=seu-segredo-aqui

# Anthropic (para os agentes de IA — Fase 2)
ANTHROPIC_API_KEY=sk-ant-...

# Evolution API — WhatsApp (Fase 2)
EVOLUTION_API_URL=https://evolution.seu-dominio.com
EVOLUTION_API_KEY=sua-chave-aqui
